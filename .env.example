# =====================================================================
# SANTÉ+ BÉNIN - VARIABLES D'ENVIRONNEMENT DE PRODUCTION
# =====================================================================

NODE_ENV=production
PORT=3000

# BASE DE DONNÉES
# PostgreSQL (recommandé pour la production)
DATABASE_URL=postgresql://sante_user:votre_password@localhost:5432/santeplus_benin
# DATABASE_URL=data/sante_production.sqlite

# AUTHENTIFICATION & SÉCURITÉ JWT
JWT_SECRET=votre_secret_jwt_tres_securise_64_caracteres_minimum
JWT_REFRESH_SECRET=votre_secret_refresh_tres_securise_64_caracteres_minimum
ASIN_AUDIT_SECRET=votre_secret_audit_national_asin_benin

# PAIEMENTS - MTN MOBILE MONEY (Bénin)
MTN_API_URL=https://api.mtn.com/v1/momo
# Pour l'environnement de test Sandbox MTN : https://sandbox.momodeveloper.mtn.com
MTN_COLLECTION_SUBSCRIPTION_KEY=votre_cle_subscription_mtn
MTN_API_USER=votre_uuid_api_user_mtn
MTN_API_KEY=votre_cle_api_mtn
MTN_TARGET_ENVIRONMENT=live
MTN_WEBHOOK_SECRET=votre_secret_signature_hmac_mtn

# PAIEMENTS - MOOV MONEY (Bénin via agrégateur CinetPay / FeexPay / FedaPay)
MOOV_API_URL=https://api-checkout.cinetpay.com/v2/payment
MOOV_API_KEY=votre_cle_api_moov_ou_agregateur
MOOV_SITE_ID=votre_site_id_ou_merchant_id
MOOV_SECRET_KEY=votre_secret_signature_hmac_moov

# PAIEMENTS - BREEZ / LNBITS (Bitcoin Lightning Network)
# Endpoint LNbits instance ou Breez SDK
LNBITS_URL=https://legend.lnbits.com
LNBITS_API_KEY=votre_cle_api_admin_lnbits
LNBITS_INVOICE_KEY=votre_cle_lecture_ecriture_invoice
BREEZ_API_KEY=votre_cle_breez_api
BREEZ_WEBHOOK_SECRET=votre_secret_webhook_breez

# NOTIFICATIONS - SMS TWILIO (Passerelle SMS Bénin +229)
TWILIO_ACCOUNT_SID=votre_twilio_account_sid
TWILIO_AUTH_TOKEN=votre_twilio_auth_token
TWILIO_PHONE_NUMBER=votre_numero_twilio_ou_sender_id_SANTEPLUS

# NOTIFICATIONS - EMAILS SENDGRID (Reçus et Ordonnances certifiées)
SENDGRID_API_KEY=votre_cle_sendgrid_api
SENDGRID_FROM_EMAIL=contact@santeplus.bj
SENDGRID_FROM_NAME=SANTÉ+ République du Bénin

# NOTIFICATIONS - FIREBASE CLOUD MESSAGING (Push Mobile & PWA)
FCM_PROJECT_ID=sante-plus-benin
FCM_PRIVATE_KEY=votre_cle_privee_firebase_format_json
FCM_CLIENT_EMAIL=firebase-adminsdk@sante-plus-benin.iam.gserviceaccount.com

# BLOCKCHAIN - ANCRAGE BITCOIN OP_RETURN
BITCOIN_NETWORK=mainnet
# API Esplora publique ou Noeud Bitcoin local
BITCOIN_EXPLORER_URL=https://blockstream.info/api
BITCOIN_RPC_HOST=127.0.0.1
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_USER=admin
BITCOIN_RPC_PASSWORD=votre_password_rpc_bitcoin

# STOCKAGE DÉCENTRALISÉ IPFS - PINATA CLOUD
PINATA_API_KEY=votre_cle_api_pinata
PINATA_SECRET_API_KEY=votre_cle_secrete_pinata
PINATA_JWT=votre_jwt_pinata_optionnel
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# INTELLIGENCE ARTIFICIELLE CLINIQUE
OPENAI_API_KEY=votre_cle_openai_api
GEMINI_API_KEY=votre_cle_gemini_api
